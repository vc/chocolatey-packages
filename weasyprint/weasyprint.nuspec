    <description>The Awesome Document Factory. WeasyPrint is a smart solution helping web developers to create PDF documents. It turns simple HTML pages into gorgeous statistical reports, invoices, tickets… This package installs the portable Windows version.</description>
    <summary>The awesome document factory - HTML to PDF converter</summary>
    <releaseNotes>https://github.com/Kozea/WeasyPrint/releases/tag/v69.0</releaseNotes>
    <tags>pdf html css converter weasyprint document</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
