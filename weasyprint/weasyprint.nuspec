<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
  <metadata>
    <id>weasyprint</id>
    <version>69.0.0</version>
    <title>WeasyPrint</title>
